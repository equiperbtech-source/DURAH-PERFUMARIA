# Senha do painel /admin (OBRIGATÓRIO trocar antes de publicar)
ADMIN_PASSWORD=troque-esta-senha
# Chave para assinar as sessões do admin (qualquer texto longo e aleatório)
SESSION_SECRET=coloque-aqui-um-texto-longo-e-aleatorio
# Porta do servidor
PORT=3000
# Pasta onde ficam o banco (db.json) e as fotos enviadas — use um disco persistente em produção
DATA_DIR=./data
# Supabase (recomendado): Project Settings → API
# SUPABASE_URL=https://xxxxxxxx.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=chave-service_role-ou-sb_secret
# SUPABASE_BUCKET=produtos
# Vercel Blob (alternativa): criado automaticamente ao conectar um Blob (Storage → Blob, acesso público)
# BLOB_READ_WRITE_TOKEN=
